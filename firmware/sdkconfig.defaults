CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=65536
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60
# A 1 ms scheduler tick. The default 100 Hz tick makes any sleep shorter than
# 10 ms round down to vTaskDelay(0) -- no delay at all -- so the button
# sampler's 5 ms period became a busy-spin at pthread priority 5 and starved
# the priority-1 main task before it could reach Wi-Fi. The same quantisation
# is why the Activity's 20 ms input loop measured 36 ms per turn.
CONFIG_FREERTOS_HZ=1000
# Needed by uxTaskGetSystemState, which is how the firmware reports the stack
# headroom of every task rather than only the three it creates itself. The
# canary fires on whichever task overflows, and ESP-IDF's own wifi and tcpip
# tasks were the ones nobody had measured.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
# Threads this firmware does not create still have to survive TLS, but the
# margin has to come out of somewhere.
#
# A task sweep found two pthreads from inside the SDK or tokio's blocking pool
# running on the 3072-byte default, one down to 868 bytes of headroom. Raising
# the default to 8192 fixed that and broke something worse: task stacks come
# from internal DRAM, of which this chip has about 512 KiB however much PSRAM
# is fitted, and the TLS handshake then had nothing left to work with. Every
# badge failed `get_system_info` with "connection reset by peer" and never
# reached the Task Queue at all, while the Mac on the same network was fine.
#
# The count is bounded in main.rs instead, which is the actual defect -- an
# unbounded pool was always going to lose this argument. 4096 gives those
# threads a little more room without spending the memory TLS needs.
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096
# A stack overflow was double-faulting, which loses the backtrace and the task
# name and leaves only `_DoubleExceptionVector`. The end-of-stack watchpoint
# traps the overflow at the boundary instead, so the panic names the task that
# ran out and the backtrace survives.
CONFIG_FREERTOS_WATCHPOINT_END_OF_STACK=y
# Every panic so far has printed `|<-CORRUPTED` after two frames, which is all
# the frame-pointer walker can do once a fault has trashed the stack. The
# DWARF unwinder reads .eh_frame instead, so the next one names the call site.
CONFIG_ESP_SYSTEM_USE_EH_FRAME=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
